APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# Get this from Supabase Dashboard → Project Settings → Database → Connection String
# Use the "URI" format (direct connection, not transaction pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Supabase Auth ───────────────────────────────────────────────────────────
# Get from Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-characters
