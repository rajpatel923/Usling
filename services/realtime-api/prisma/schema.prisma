generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors the Supabase auth.users record. Created automatically on first
// authenticated request; never deleted (pairs reference it).
model Profile {
  id        String   @id  // Supabase user UUID (matches auth.users.id)
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  pairMembership PairMember?
  invitesCreated Invite[]

  @@map("profiles")
}

// Single-use, time-limited invite that creates a Pair on acceptance.
model Invite {
  code      String    @id  // 6-character alphanumeric (nanoid)
  creatorId String
  creator   Profile   @relation(fields: [creatorId], references: [id])

  pairId    String?
  pair      Pair?     @relation(fields: [pairId], references: [id])

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("invites")
}

// A relationship between exactly two people.
model Pair {
  id        String       @id @default(uuid())
  members   PairMember[]
  invites   Invite[]
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("pairs")
}

// Enforces the 2-person constraint: userId is @unique so each user
// can belong to at most one pair at a time.
model PairMember {
  pairId String
  userId String @unique  // one active pair per user

  pair    Pair    @relation(fields: [pairId], references: [id])
  profile Profile @relation(fields: [userId], references: [id])

  @@id([pairId, userId])
  @@map("pair_members")
}
