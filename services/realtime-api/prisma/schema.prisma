// Prisma schema — Pair Companion realtime API
// Week 4: stubs only. Full migrations begin in Week 5 (authentication and pairing).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
  memberships PairMember[]
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  publicKey String   // device identity key stored server-side
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pair {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  members   PairMember[]
  invites   Invite[]
}

model PairMember {
  id          String   @id @default(cuid())
  pairId      String
  pair        Pair     @relation(fields: [pairId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  characterId String   @unique  // one character per user per pair
  joinedAt    DateTime @default(now())

  @@unique([pairId, userId])
}

model Invite {
  id        String    @id @default(cuid())
  pairId    String
  pair      Pair      @relation(fields: [pairId], references: [id])
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String
  refreshToken String    @unique  // hashed
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
}
